            <!-- ========================= -->
            <!-- 5️⃣ KAYDET -->
            <!-- ========================= -->
            <Button
              Grid.Row="4"
              Text="Kaydet"
              HeightRequest="50"
              FontSize="16"
              CornerRadius="14"
              Command="{Binding SaveTransferCommand}"
              BackgroundColor="#2563EB"
              TextColor="White"
              IsEnabled="{Binding HasActiveTransfer}"
          />

        </Grid>
        <!-- ========================= -->
        <!-- 🏭 WHOUSE POPUP -->
        <!-- ========================= -->
        <Grid
          IsVisible="{Binding IsWhousePickerOpen}"
          BackgroundColor="#80000000"
          Grid.RowSpan="6">

            <!-- Popup İçerik -->
            <Border
              WidthRequest="340"
              BackgroundColor="White"
              Padding="12"
              StrokeShape="RoundRectangle 14"
              HorizontalOptions="Center"
              VerticalOptions="Center"> 

                <VerticalStackLayout Spacing="10">

                    <!-- Başlık -->
                    <Label
                      Text="Depo Seç"
                      FontSize="16"
                      FontAttributes="Bold"
                      HorizontalOptions="Center" />

                    <!-- Liste -->
                    <CollectionView
                      ItemsSource="{Binding Whouses}"
                      SelectionMode="Single"
                      SelectionChanged="OnWhouseSelected"
                      HeightRequest="300">

                        <CollectionView.ItemTemplate>
                            <DataTemplate>
                                <Border
                          Padding="10"
                          Margin="4"
                          Stroke="#E5E7EB"
                          Background="#F8FAFC"
                          StrokeShape="RoundRectangle 10">

                                    <VerticalStackLayout>
                                        <Label
                                  Text="{Binding Code}"
                                  FontAttributes="Bold" />
                                        <Label
                                  Text="{Binding Name}"
                                  FontSize="12"
                                  TextColor="Gray" />
                                    </VerticalStackLayout>
                                </Border>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>

                    </CollectionView>

                    <!-- Kapat -->
                    <Button
                      Text="Vazgeç"
                      Command="{Binding CloseWhousePickerCommand}"
                      BackgroundColor="#E5E7EB"
                      TextColor="#111827"
                      CornerRadius="10"
                     /> 

                </VerticalStackLayout>
            </Border>
        </Grid>
        <!--   POPUP -->
        <!-- ========================= -->
        <Grid
          IsVisible="{Binding IsTransferPickerOpen}"
          BackgroundColor="#80000000"
          Grid.RowSpan="6">

                <!-- Popup İçerik -->
            <Border
              WidthRequest="340"
              BackgroundColor="White"
              Padding="12"
              StrokeShape="RoundRectangle 14"
              HorizontalOptions="Center"
              VerticalOptions="Center">

                <VerticalStackLayout Spacing="10">

                    <!-- Başlık -->
                    <Label
                  Text="Sepet Seç"
                  FontSize="16"
                  FontAttributes="Bold"
                  HorizontalOptions="Center" />

                    <!-- Liste -->
                    <CollectionView
                                  ItemsSource="{Binding Transfers}"
                                  SelectionMode="Single"
                                  SelectionChanged="OnTransferSelected"
                                  HeightRequest="300">

                        <CollectionView.ItemTemplate>
                            <DataTemplate>
                                <Border
                                  Padding="10"
                                  Margin="4"
                                  Stroke="#E5E7EB"
                                  Background="#F8FAFC"
                                  StrokeShape="RoundRectangle 10">

                                    <VerticalStackLayout>
                                        <Label
                                      Text="{Binding Code}"
                                      FontAttributes="Bold" />
                                        <!--<Label
                          Text="{Binding Name}"
                          FontSize="12"
                          TextColor="Gray" />-->
                                    </VerticalStackLayout>
                                </Border>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>

                    </CollectionView>

                    <!-- Kapat -->
                    <Button
                      Text="Vazgeç"
                      Command="{Binding CloseTransferPickerCommand}"
                      BackgroundColor="#E5E7EB"
                      TextColor="#111827"
                      CornerRadius="10"/>   

                </VerticalStackLayout>
            </Border>
        </Grid>
    </Grid>
</ContentPage>