<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="DepoX.Features.FromWorder.FromWorderPage"
             Title="FromWorderPage">
    <Grid>
        <Grid
      RowDefinitions="Auto,Auto,*,*,Auto"
      RowSpacing="8"
      Padding="10">

            <!-- ========================= -->
            <!-- 1️⃣ BELGE + WHOUSE HEADER -->
            <!-- ========================= -->
            <Border
          Grid.Row="0"
          Stroke="#CBD5E1"
          StrokeThickness="1"
          Background="#F8FAFC"
          Padding="10"
          StrokeShape="RoundRectangle 12">

                <VerticalStackLayout Spacing="10">

                    <!-- 🧺 BELGE SATIRI -->
                    <Grid
                      ColumnDefinitions="Auto,3*,2*"
                      ColumnSpacing="8"
                      VerticalOptions="Center">

                        <!-- Belge İkonu -->
                        <Border
                      WidthRequest="42"
                      HeightRequest="42"
                      Stroke="#CBD5E1"
                      Background="#EFF6FF"
                      StrokeShape="RoundRectangle 10">
                            <Label
                              Text="📋"
                              FontSize="20"
                              HorizontalOptions="Center"
                              VerticalOptions="Center" />
                                <Border.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding OpenTransferListCommand}" />
                            </Border.GestureRecognizers>
                        </Border>

                        <!-- Belge No -->
                        <Entry
                          Grid.Column="1"
                          Placeholder="Talep No"
                          Text="{Binding TransferNo}"
                          HeightRequest="42"
                          IsEnabled="false" />
                        <Entry
                           Grid.Column="2"
                           Placeholder="Hedef Depo"
                           Text="{Binding WhouseCode}"
                           HeightRequest="42"
                           IsEnabled="false" />

                    </Grid>
                    <!-- 📦 WHOUSE SATIRI -->
                    <Grid
                      ColumnDefinitions="Auto,*"
                      ColumnSpacing="8"
                      VerticalOptions="Center">

                        <!-- Whouse İkonu -->
                        <Border
                      WidthRequest="42"
                      HeightRequest="42"
                      Stroke="#CBD5E1"
                      Background="#F5F3FF"
                      StrokeShape="RoundRectangle 10">
                            <Label
                          Text="📦"
                          FontSize="20"
                          HorizontalOptions="Center"
                          VerticalOptions="Center" />
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding OpenWhouseListCommand}" />
                            </Border.GestureRecognizers>
                        </Border>

                        <!-- Whouse -->
                        <Entry
                          Grid.Column="1"
                          Placeholder="Kaynak Depo Seçiniz"
                          Text="{Binding SelectedWhouse.Name}"
                          HeightRequest="42"
                          IsEnabled="false" />

                     
                    </Grid>

                </VerticalStackLayout>
            </Border>
            <!-- ========================= -->



            <!-- ========================= -->
            <!-- 2️⃣ BARKOD OKUTMA -->
            <!-- ========================= -->
            <Border
              Grid.Row="1"
              Stroke="#38BDF8"
              StrokeThickness="1"
              Background="#ECFEFF"
              Padding="8"
              StrokeShape="RoundRectangle 10"
              IsEnabled="{Binding CanScanBarcode}"
              IsVisible="{Binding CanScanBarcode}">

                <Entry
              x:Name="BarcodeEntry"
              Placeholder="Barkod okutun"
              FontSize="18"
              ReturnType="Done"   
              IsEnabled="{Binding CanScanBarcode}"
              IsVisible="{Binding CanScanBarcode}"
              Completed="OnBarcodeCompleted"
              />
            </Border>


            <!-- ========================= -->
            <!-- 4️⃣ SEPETTEKİ BARKODLAR -->
            <!-- ========================= --><!--
            <Border
          Grid.Row="2"
          Stroke="#CBD5E1"
          StrokeThickness="1"
          Background="White"
          Padding="8"
          StrokeShape="RoundRectangle 12">

                <Grid RowDefinitions="Auto,*"
                RowSpacing="6">

                    <Label
                  Grid.Row="0"
                  Text="Barkodlar"
                  FontAttributes="Bold"
                  TextColor="#0F172A" />
                    --><!-- İnce ayırıcı --><!--
                    <BoxView
                    HeightRequest="1"
                    BackgroundColor="#E5E7EB"
                    Opacity="0.8" />

                    <CollectionView
                      Grid.Row="1"
                      ItemsSource="{Binding Barcodes}"
                      VerticalOptions="Fill">

                        <CollectionView.ItemTemplate>
                            <DataTemplate>
                                <Grid
                                  ColumnDefinitions="*,Auto"
                                  Padding="6">

                                    <Label
                                      Grid.Column="0"
                                      Text="{Binding Code}"
                                      FontAttributes="Bold"
                                      TextColor="#0F172A" />

                                    <Label
                                      Grid.Column="1"
                                      Text="{Binding WhouseCode}"
                                      FontAttributes="Bold"
                                      TextColor="#0F172A" />

                                    --><!--<Label
                                      Grid.Column="2"
                                      Text="{Binding Quantity}"
                                      TextColor="#334155" />--><!--
                                </Grid>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>

                    </CollectionView>

                </Grid>
            </Border>-->
            <!-- ========================= -->
            <!-- 4️⃣ SEPETTEKİ BARKODLAR -->
            <!-- ========================= -->
            <Border
    Grid.Row="2"
    Stroke="#CBD5E1"
    StrokeThickness="1"
    Background="White"
    Padding="8"
    StrokeShape="RoundRectangle 12">

                <Grid
        RowDefinitions="Auto,Auto,*"
        RowSpacing="6">

                    <Label
            Grid.Row="0"
            Text="Barkodlar"
            FontAttributes="Bold"
            TextColor="#0F172A" />

                    <!-- İnce ayırıcı -->
                    <BoxView
            Grid.Row="1"
            HeightRequest="1"
            BackgroundColor="#E5E7EB"
            Opacity="0.8" />

                    <CollectionView
            Grid.Row="2"
            ItemsSource="{Binding Barcodes}"
            VerticalOptions="Fill">

                        <CollectionView.ItemTemplate>
                            <DataTemplate>

                                <Grid
                        ColumnDefinitions="*,Auto"
                        RowDefinitions="Auto,Auto"
                        Padding="6">

                                    <Label
                            Grid.Row="0"
                            Grid.Column="0"
                            Text="{Binding Code}"
                            FontAttributes="Bold"
                            TextColor="#0F172A" />

                                    <Label
                            Grid.Row="0"
                            Grid.Column="1"
                            Text="{Binding WhouseCode}"
                            FontAttributes="Bold"
                            TextColor="#0F172A" />

                                    <!-- SATIR ALTI ÇİZGİ -->
                                    <BoxView
                            Grid.Row="1"
                            Grid.ColumnSpan="2"
                            HeightRequest="1"
                            BackgroundColor="#E5E7EB"
                            Opacity="0.6" />

                                </Grid>

                            </DataTemplate>
                        </CollectionView.ItemTemplate>

                    </CollectionView>

                </Grid>
            </Border>


            <!-- ========================= -->
            <!-- 3️⃣ ERP STOKLAR -->
            <!-- ========================= -->
            <Border
    Grid.Row="3"
    Stroke="#A7F3D0"
    StrokeThickness="1"
    Background="#F0FDF4"
    Padding="8"
    StrokeShape="RoundRectangle 12">

                <Grid RowDefinitions="Auto,Auto,*"
          RowSpacing="6">

                    <Label
            Grid.Row="0"
            Text="Stoklar"
            FontAttributes="Bold"
            TextColor="#065F46" />

                    <!-- İnce ayırıcı -->
                    <BoxView
            Grid.Row="1"
            HeightRequest="1"
            BackgroundColor="#E5E7EB"
            Opacity="0.8" />

                    <CollectionView
            Grid.Row="2"
            ItemsSource="{Binding Items}"
            VerticalOptions="Fill">

                        <CollectionView.ItemTemplate>
                            <DataTemplate>

                                <!-- SATIR -->
                                <Grid
                        ColumnDefinitions="2*,Auto,5*,Auto,*"
                        RowDefinitions="Auto,Auto,Auto"
                        Padding="0">

                                    <!-- Depo -->
                                    <Label
                            Grid.Row="0"
                            Grid.Column="0"
                            Padding="5,0,0,5"
                            Text="{Binding WhouseCode}"
                            FontAttributes="Bold"
                            TextColor="#0F172A" />

                                    <!-- Dikey çizgi -->
                                    <BoxView
                            Grid.Row="0"
                            Grid.RowSpan="2"
                            Grid.Column="1"
                            WidthRequest="1"
                            BackgroundColor="#E5E7EB"
                            Opacity="0.6" />

                                    <!-- Stok Kodu -->
                                    <Label
                            Grid.Row="0"
                            Grid.Column="2"
                            Padding="5,0,0,5"
                            Text="{Binding Code}"
                            FontAttributes="Bold"
                            TextColor="#0F172A" />

                                    <!-- Dikey çizgi -->
                                    <BoxView
                            Grid.Row="0"
                            Grid.RowSpan="2"
                            Grid.Column="3"
                            WidthRequest="1"
                            BackgroundColor="#E5E7EB"
                            Opacity="0.6" />

                                    <!-- Miktar -->
                                    <Label
                            Grid.Row="0"
                            Grid.Column="4"
                            Padding="5,0,0,5"
                            Text="{Binding Quantity}"
                            HorizontalTextAlignment="End"
                            TextColor="#334155" />

                                    <!-- SATIR ALTI ÇİZGİ -->
                                    <BoxView
                            Grid.Row="2"
                            Grid.ColumnSpan="5"
                            HeightRequest="1"
                            BackgroundColor="#E5E7EB"
                            Opacity="0.6" />

                                </Grid>

                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>

                </Grid>
            </Border>


