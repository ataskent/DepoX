                                                CommandParameter="{Binding .}" />
                                        </SwipeItems>
                                    </SwipeView.LeftItems>

                                    <Grid
                                        Padding="8"
                                        ColumnDefinitions="*,Auto">

                                        <Label
                                            Text="{Binding Code}"
                                            FontAttributes="Bold" />

                                        <Label
                                            Grid.Column="1"
                                            Text="{Binding Quantity}"
                                            FontAttributes="Bold"
                                            HorizontalTextAlignment="End" />
                                    </Grid>

                                </SwipeView>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>

                    </CollectionView>
                </Grid>-->
            </Border>

            <!-- ========================= -->
            <!-- 3️⃣ ERP STOKLAR -->
            <!-- ========================= -->
            <Border
              Grid.Row="3"
              Stroke="#A7F3D0"
              StrokeThickness="1"
              Background="#F0FDF4"
              Padding="8"
              StrokeShape="RoundRectangle 12">      

                <Grid RowDefinitions="Auto,Auto,*"
                    RowSpacing="0">

                    <Label
              Grid.Row="0"
              Text="Stoklar"
              FontAttributes="Bold"
              TextColor="#065F46" />

                    <BoxView
              Grid.Row="1"
              Margin="0,4"
               HeightRequest="1"
               BackgroundColor="#75777B"
               Opacity="0.4" />

                    <CollectionView                        
                      Grid.Row="2"
                      ItemsSource="{Binding Items}"
                      VerticalOptions="Fill">
                        <CollectionView.ItemTemplate>
                            <DataTemplate>
                                <Grid
                      RowDefinitions="*,*,*,*"
                      ColumnDefinitions="*"
                      Padding="0">

                                    <Label
                          Grid.Row="0"
                          Grid.Column="0"
                          Text="{Binding Code}"
                          FontAttributes="Bold"
                          TextColor="#333333" />

                                    <Label
                            Grid.Row="1"
                            Grid.Column="0"
                            FontSize="10"
                            Text="{Binding Name}"                                      
                            TextColor="#333333" />

                                    <Label
                            Grid.Row="2"
                            Grid.Column="1"
                            Text="{Binding LineA}"
                                   FontSize="10"
                                   TextColor="#0F172A" />

                                    <BoxView
                           Grid.Row="3" 
                           Margin="0,4"
                            HeightRequest="1"
                            BackgroundColor="#75777B"
                            Opacity="0.4" />
                                </Grid>

                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>
                </Grid>
            </Border>
