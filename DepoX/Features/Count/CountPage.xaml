            <!-- ========================= -->
            <!-- 4️⃣ KAYDET -->
            <!-- ========================= -->
            <Button
                Grid.Row="4"
                Text="Kaydet"
                HeightRequest="50"
                FontSize="16"
                CornerRadius="14"
                BackgroundColor="#2563EB"
                TextColor="White"
                IsEnabled="{Binding HasActiveCount}"
                Clicked="OnSaveClicked" />

        </Grid>

        <!-- ========================= -->
        <!-- 🏭 DEPO POPUP -->
        <!-- ========================= -->
        <Grid
            IsVisible="{Binding IsWhousePickerOpen}"
            BackgroundColor="#80000000">

            <Border
                WidthRequest="340"
                BackgroundColor="White"
                Padding="12"
                StrokeShape="RoundRectangle 14"
                HorizontalOptions="Center"
                VerticalOptions="Center">

                <VerticalStackLayout Spacing="10">

                    <Label
                        Text="Depo Seç"
                        FontSize="16"
                        FontAttributes="Bold"
                        HorizontalOptions="Center" />

                    <CollectionView
                        ItemsSource="{Binding Whouses}"
                        SelectionMode="Single"
                        SelectionChanged="OnWhouseSelected"
                        HeightRequest="300" >


                        <CollectionView.ItemTemplate>
                            <DataTemplate>
                                <Border
                          Padding="10"
                          Margin="4"
                          Stroke="#E5E7EB"
                          Background="#F8FAFC"
                          StrokeShape="RoundRectangle 10">

                                    <VerticalStackLayout>
                                        <Label
                                  Text="{Binding Code}"
                                  FontAttributes="Bold" />
                                        <Label
                                  Text="{Binding Name}"
                                  FontSize="12"
                                  TextColor="Gray" />
                                    </VerticalStackLayout>
                                </Border>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>

                    </CollectionView>

                    <Button
                        Text="Vazgeç"
                        BackgroundColor="#E5E7EB"
                        CornerRadius="10"
                        Clicked="OnCloseWhousePicker" />
                </VerticalStackLayout>
            </Border>
        </Grid>

        <!-- ========================= -->
        <!-- 📋 SAYIM FİŞİ POPUP -->
        <!-- ========================= -->
        <Grid
            IsVisible="{Binding IsCountPickerOpen}"
            BackgroundColor="#80000000">

            <Border
                WidthRequest="340"
                BackgroundColor="White"
                Padding="12"
                StrokeShape="RoundRectangle 14"
                HorizontalOptions="Center"
                VerticalOptions="Center">

                <VerticalStackLayout Spacing="10">

                    <Label
                        Text="Sayım Fişi Seç"
                        FontSize="16"
                        FontAttributes="Bold"
                        HorizontalOptions="Center" />

                    <CollectionView
                        ItemsSource="{Binding Counts}"
                        SelectionMode="Single"
                        SelectionChanged="OnCountSelected"
                        HeightRequest="300" >

                        <CollectionView.ItemTemplate>
                            <DataTemplate>
                                <Border
                                     Padding="10"
                                     Margin="4"
                                     Stroke="#E5E7EB"
                                     Background="#F8FAFC"
                                     StrokeShape="RoundRectangle 10">

                                                            <VerticalStackLayout>
                                                                <Label
                                         Text="{Binding Code}"
                                         FontAttributes="Bold" />
                                                                <!--<Label
                             Text="{Binding Name}"
                             FontSize="12"
                             TextColor="Gray" />-->
                                    </VerticalStackLayout>
                                </Border>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>

                    </CollectionView>

                    <Button
                        Text="Vazgeç"
                        BackgroundColor="#E5E7EB"
                        CornerRadius="10"
                        Clicked="OnCloseCountPicker" />
                </VerticalStackLayout>
            </Border>
        </Grid>

    </Grid>
</ContentPage>
