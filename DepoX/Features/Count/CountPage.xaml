<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="DepoX.Features.Count.CountPage"
    Title="Depo Sayım">

    <Grid>

        <Grid
            RowDefinitions="Auto,Auto,*,*,Auto"
            RowSpacing="8"
            Padding="10">

            <!-- ========================= -->
            <!-- 1️⃣ SAYIM FİŞİ + DEPO -->
            <!-- ========================= -->
            <Border
                Grid.Row="0"
                Stroke="#CBD5E1"
                StrokeThickness="1"
                Background="#F8FAFC"
                Padding="10"
                StrokeShape="RoundRectangle 12">

                <VerticalStackLayout Spacing="10">

                    <!-- 🧾 SAYIM FİŞİ -->
                    <Grid
                        ColumnDefinitions="Auto,*,Auto"
                        ColumnSpacing="8">

                        <!-- Fiş ikonu -->
                        <Border
                            WidthRequest="42"
                            HeightRequest="42"
                            Background="#EFF6FF"
                            Stroke="#CBD5E1"
                            StrokeShape="RoundRectangle 10">
                            <Label
                                Text="📋"
                                FontSize="20"
                                HorizontalOptions="Center"
                                VerticalOptions="Center" />
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding OpenCountListCommand}" />
                            </Border.GestureRecognizers>
                        </Border>

                        <!-- Fiş No -->
                        <Entry
                            Grid.Column="1"
                            Placeholder="Sayım fişi seçiniz / giriniz"
                            Text="{Binding CountNo}"
                            HeightRequest="42" />

                        <!-- Yeni -->
                        <Button
                            Grid.Column="2"
                            Text="Yeni"
                            Padding="1"
                            WidthRequest="46"
                            HeightRequest="42"
                            FontSize="12"
                            FontAttributes="Bold"
                            Command="{Binding NewCountCommand}"
                            BackgroundColor="#2563EB"
                            TextColor="White"
                            CornerRadius="10" />

                       
                    </Grid>

                    <!-- 🏭 DEPO -->
                    <Grid
                        ColumnDefinitions="Auto,*,Auto"
                        ColumnSpacing="8">

                        <!-- Depo ikonu -->
                        <Border
                            WidthRequest="42"
                            HeightRequest="42"
                            Background="#F5F3FF"
                            Stroke="#CBD5E1"
                            StrokeShape="RoundRectangle 10">
                            <Label
                                Text="🏭"
                                FontSize="20"
                                HorizontalOptions="Center"
                                VerticalOptions="Center" />
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding OpenWhouseListCommand}" />
                            </Border.GestureRecognizers>
                        </Border>

                        <!-- Depo adı -->
                        <Entry
                            Grid.Column="1"
                            Placeholder="Depo seçiniz"
                            Text="{Binding SelectedWhouse.Name}"
                            HeightRequest="42"
                            IsEnabled="False" />

                        <!-- Sil -->
                        <Button
                         Grid.Column="2"
                         Text="Sil"
                         WidthRequest="46"
                         HeightRequest="42"
                         FontSize="12"
                         Padding="1"
                         FontAttributes="Bold"
                         Command="{Binding DeleteCountCommand}"
                         IsEnabled="{Binding HasActiveCount}"
                         BackgroundColor="#6F1239"
                         TextColor="White"
                         CornerRadius="10" />

                        <!-- Temizle --><!--
                        <Button
                            Grid.Column="2"
                            Text="Boşalt"
                            WidthRequest="100"
                            HeightRequest="42"
                            FontSize="12"
                            FontAttributes="Bold"
                            Command="{Binding ClearItemsCommand}"
                            IsEnabled="{Binding HasActiveCount}"
                            BackgroundColor="#6D28D9"
                            TextColor="White"
                            CornerRadius="10" />-->
                    </Grid>

                </VerticalStackLayout>
            </Border>

            <!-- ========================= -->
            <!-- 2️⃣ BARKOD OKUTMA -->
            <!-- ========================= -->
            <Border
                Grid.Row="1"
                Stroke="#38BDF8"
                Background="#ECFEFF"
                Padding="8"
                StrokeShape="RoundRectangle 10"
                IsVisible="{Binding CanScanBarcode}">

                <Entry
                    x:Name="BarcodeEntry"
                    Placeholder="Barkod okutun"
                    FontSize="18"
                    ReturnType="Done"
                    Completed="OnBarcodeCompleted" />
            </Border>

            <!-- ========================= -->
            <!-- 3️⃣ BARKODLAR -->
            <!-- ========================= -->
            <Border
                Grid.Row="2"
                Stroke="#CBD5E1"
                Background="White"
                Padding="8"
                StrokeShape="RoundRectangle 12">


                <Grid RowDefinitions="Auto,Auto,*"
                  RowSpacing="0">

                    <Label
                    Grid.Row="0"
                    Text="Barkodlar"
                    FontAttributes="Bold"
                    TextColor="#0F172A" />

                    <BoxView
                     Grid.Row="1"
                     Margin="0,4"
                      HeightRequest="1"
                      BackgroundColor="#75777B"
                      Opacity="0.4" />

                    <CollectionView
                        Grid.Row="2"
                        ItemsSource="{Binding Barcodes}"
                        SelectionMode="None">

                        <CollectionView.ItemTemplate>
                            <DataTemplate>
                                <SwipeView>

                                    <SwipeView.LeftItems>
                                        <SwipeItems Mode="Reveal">
                                            <SwipeItem
                                              Text="Sil"
                                              BackgroundColor="Tomato"
                                              Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.RemoveItemCommand}"
                                              CommandParameter="{Binding .}" />
                                        </SwipeItems>
                                    </SwipeView.LeftItems>
                                    <Grid
                                    RowDefinitions="*,*,*,*,*"
                                    ColumnDefinitions="*"
                                    Padding="0">

                                        <Label
                                        Grid.Row="0"
                                        Grid.Column="0"
                                        Text="{Binding Code}"
                                        FontAttributes="Bold"
                                        TextColor="DarkRed" />


                                        <Label 
                                        Grid.Row="1" 
                                        Text="{Binding ItemCode}"
                                           FontSize="12"
                                           TextColor="#0F172A" />
                                        <!--<Label 
                                        Grid.Row="2" Grid.ColumnSpan="2"
                                        Text="{Binding ItemName}"
                                            FontSize="12"
                                            TextColor="#0F172A" />-->

                                        <Label 
                                         Grid.Row="2" 
                                         Text="{Binding LineA}"
                                            FontSize="10"
                                            TextColor="#0F172A" />
                                        <Label 
                                          Grid.Row="3" 
                                          Text="{Binding LineB}"
                                             FontSize="10"
                                             TextColor="#0F172A" />
                                        <BoxView
                                         Grid.Row="4" 
                                         Margin="0,4"
                                          HeightRequest="1"
                                          BackgroundColor="#75777B"
                                          Opacity="0.4" />
                                    </Grid>
                                </SwipeView>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>

                    </CollectionView>

                </Grid>

                <!--<Grid RowDefinitions="Auto,Auto,*" RowSpacing="6">

                    <Label
                        Text="Barkodlar"
                        FontAttributes="Bold"
                        TextColor="#0F172A" />

                    
                    <BoxView
